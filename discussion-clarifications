    mutable std::shared_mutex mtx;

public:
    // Multiple readers can execute concurrently.
    int read(const std::string& key) const {
        std::shared_lock<std::shared_mutex> lock(mtx);

        auto it = data.find(key);
        if (it != data.end()) {
            return it->second;
        }
        return -1; // Key not found
