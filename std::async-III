For a MAANG Staff Engineer interview, you can implement this using three `std::async` tasks that return futures, followed 
by a final thread that waits for all three futures using `get()`.

This demonstrates asynchronous execution, future synchronization, result collection, and exception propagation.

## 1. Complete C++ implementation

```

#include <iostream>
#include <future>
#include <thread>
#include <chrono>
#include <vector>

int computeValue(int id, int value)
{
    std::cout << "Task " << id
              << " started on thread "
              << std::this_thread::get_id() << '\n';

    // Simulate a long-running computation
    std::this_thread::sleep_for(
        std::chrono::seconds(id));

    int result = value * value;

    std::cout << "Task " << id
              << " completed. Result = "
              << result << '\n';

    return result;
}

int main()
{
    // Launch three asynchronous computations
    std::future<int> f1 = std::async(
        std::launch::async, computeValue, 1, 10);

    std::future<int> f2 = std::async(
        std::launch::async, computeValue, 2, 20);

    std::future<int> f3 = std::async(
        std::launch::async, computeValue, 3, 30);

    // Final thread waits for all three results
    std::thread finalThread([&]()
    {
        std::cout << "Final thread waiting for results...\n";

        int r1 = f1.get();
        int r2 = f2.get();
        int r3 = f3.get();

        int total = r1 + r2 + r3;

        std::cout << "All tasks completed.\n";
        std::cout << "Results: "
                  << r1 << ", " << r2 << ", " << r3 << '\n';
        std::cout << "Final total = " << total << '\n';
    });

    // Main thread waits for the final thread
    finalThread.join();

    std::cout << "Main thread exiting.\n";

    return 0;
}

```

### Compile and run

```
g++ -std=c++17 -pthread main.cpp -o main
./main
```

